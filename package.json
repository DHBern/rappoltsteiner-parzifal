{
  "name": "dh-parzival",
  "version": "1.0.2",
  "private": true,
  "description": "The Parzival-Projekt – a genetic digital edition of Wolfram von Eschenbach's ‹Parzival›",
  "author": "pagina GmbH",
  "scripts": {
    "serve": "vue-cli-service serve --open",
    "build": "npm run prepare-data && vue-cli-service build",
    "configure": "babel-node --config-file ./babel-node.config.js src/build/configure.js",
    "img2dzi": "babel-node --config-file ./babel-node.config.js src/build/img2dzi.js",
    "img2ptif": "babel-node --config-file ./babel-node.config.js src/build/img2ptif.js",
    "prepare-data": "babel-node --config-file ./babel-node.config.js src/build/data.js",
    "upgrade": "vue upgrade"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.11",
    "animate.css": "^3.7.2",
    "bulma": "^0.7.5",
    "core-js": "^3.47.0",
    "csv": "^5.5.3",
    "debug": "^4.4.3",
    "del": "^4.1.1",
    "escape-html": "^1.0.3",
    "font-awesome": "^4.7.0",
    "fs-extra": "^7.0.1",
    "globby": "^9.2.0",
    "intersection-observer": "^0.12.2",
    "lodash.debounce": "^4.0.8",
    "lodash.merge": "^4.6.2",
    "mississippi": "^4.0.0",
    "openseadragon": "^2.4.2",
    "optional": "^0.1.4",
    "sax": "^1.4.3",
    "scroll-into-view": "^1.16.2",
    "vue": "^2.7.16",
    "vue-focus": "^2.1.0",
    "vue-lazyload": "^1.3.5",
    "vue-match-media": "^1.0.3",
    "vue-meta": "^1.6.0",
    "vue-router": "^3.6.5",
    "vue-scrollto": "^2.20.0",
    "vue-waypoint": "^3.5.2",
    "xmlbuilder": "^12.0.1",
    "xpath": "0.0.32"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/node": "^7.28.0",
    "@babel/polyfill": "^7.12.1",
    "@vue/cli-plugin-babel": "^5.0.9",
    "@vue/cli-service": "^5.0.9",
    "coffeescript": "^2.7.0",
    "node-sass": "^8.0.0",
    "sass-loader": "^16.0.6",
    "vue-template-compiler": "^2.7.16"
